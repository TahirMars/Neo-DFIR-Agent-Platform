# Neo 后端环境变量示例（密钥勿提交）
# 复制为 .env 后修改

# API
API_V1_PREFIX=/api/v1

# 认证（JWT）
JWT_SECRET=your-secret-change-in-production
JWT_EXPIRE_SECONDS=86400
# 开发/测试可跳过鉴权（集成测试默认 true）
# AUTH_DISABLED=true

# 大模型（OpenAI 兼容接口，如阿里云百炼通义千问）
# 阿里云百炼：https://help.aliyun.com/zh/model-studio/compatibility-of-openai-with-dashscope
# LLM_MODEL=qwen-plus
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxx
# LLM_TIMEOUT_SECONDS=60
# LLM_TIMEOUT_AGENT_SECONDS=180

# 会话与多智能体上下文（可选；与 Settings 字段对应，未设置则用代码默认值）
# 单条历史消息纳入 compact 前的最大字符数（send_chat / runtime / pipeline 统一）
# SESSION_MEMORY_SINGLE_MSG_MAX_CHARS=4000
# format_session_memory_for_graph 输出上限
# SESSION_CONTEXT_FORMATTED_MAX_CHARS=12000
# compose_agent_user_context 拼接总预算（子 Agent 用户侧提示）
# COMPOSED_USER_CONTEXT_MAX_CHARS=28000
# 会话总字符超过此值触发 LLM 摘要并写入 conversation_history.md
# CONTEXT_MEMORY_TRIGGER_CHARS=60000
# 总字符在 [本值, CONTEXT_MEMORY_TRIGGER) 时写入 snapshots/dialog_pre_summarize.md（无 LLM）
# CONTEXT_MEMORY_LIGHT_APPEND_CHARS=12000
# 是否写入 workspace 下会话快照与 artifacts/analysis_runs.md（每轮分析追加）
# SESSION_WORKSPACE_PERSISTENCE_ENABLED=true
# analysis_runs.md 中单块正文上限
# SESSION_RUN_ARTIFACT_MAX_CHARS_PER_BLOCK=24000
# 新建案件或首次 load 时是否在 workspace 下写入 .case_memory.md 模板
# CASE_MEMORY_AUTO_INIT_ENABLED=true

# LangGraph 内存 checkpointer（默认关闭；开启后 ainvoke/astream 传入 thread_id，响应含 graph_thread_id）
# LANGGRAPH_CHECKPOINT_ENABLED=false

# Neo Skills（SKILL.md 注入子 Agent；关闭则忽略 skill_ids）
# SKILLS_ENABLED=true
# SKILLS_DESCRIPTION_MAX_CHARS=320
# SKILLS_BODY_MAX_CHARS=8000
# 单文件 SKILL.md 上传上限（案件工作区）
# SKILLS_UPLOAD_MAX_BYTES=262144
# 是否启用 skills_routing.yaml 自动挂载
# SKILLS_ROUTING_ENABLED=true
# 路由规则 YAML 路径（文件不存在则仅使用显式 skill_ids）
# SKILLS_ROUTING_RULES_PATH=./data/skills_routing.yaml
# F3：系统提示中技能注入方式 full=含正文；catalog_only=仅目录，用 load_skill 拉正文
# SKILLS_DEFAULT_INJECT_MODE=full
# SKILLS_LOAD_TOOL_ENABLED=true
# SKILLS_LOAD_SKILL_RESULT_MAX_CHARS=12000
# F3：LLM 根据用户问题追加推荐 skill_id（需配置 LLM_API_KEY）
# SKILLS_LLM_ROUTING_ENABLED=false
# SKILLS_LLM_ROUTING_MAX_SUGGESTIONS=3

# 数据库与缓存（可选；未配置时使用内存）
# DATABASE_URL=postgresql://user:pass@localhost:5432/neo

# 证据与存储（可选）
# EVIDENCE_STORAGE_PATH=./data/evidence
# SAMPLE_WORKSPACE_PATH=./data/sample_workspace
# 动态样本分析：外部命令（shlex 拆分），Neo 将解析后的样本绝对路径追加为最后一参，stdout 为 JSON
# SAMPLE_DYNAMIC_SUBPROCESS=python your_runner.py --sample
# SAMPLE_DYNAMIC_TIMEOUT_SECONDS=600
# UPLOAD_MAX_BYTES=536870912

# 威胁情报 MCP（可选；未配置 VirusTotal 时使用模拟数据）
# VIRUSTOTAL_API_KEY=your-vt-api-key
# TI_WHITELIST_PATH=./data/ti_whitelist.txt
# TI_CACHE_PATH=./data/ti_cache.db
# SANGFOR_COOKIE=...
# SANGFOR_CSRF_TOKEN=...
